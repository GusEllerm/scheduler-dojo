# Reference kata: order short jobs first, then *fill the gaps* a big job cannot use.
# Teaches Level 3's starvation fix — when a queued job is too big to fit right now, do not
# idle the free nodes and do not reach past it for another big one; backfill the short jobs
# that fit, and leave the big job's capacity to accumulate until fits_later turns into fits_now.

order by shortest_first:
    key = (job.walltime_req, job.submit_time)

place by gap_fill:
    for j in queue():
        if fits_now(j):
            place(j)
        elif fits_later(j):
            break
